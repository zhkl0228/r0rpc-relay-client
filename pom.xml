<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 http://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>

    <groupId>com.github.zhkl0228</groupId>
    <artifactId>r0rpc-relay-client</artifactId>
    <version>1.2.0</version>
    <packaging>jar</packaging>
    <name>r0rpc-relay-client</name>
    <description>r0rpc 设备端 SDK（数据模型用 org.json.JSONObject：Android 走系统自带、桌面 JVM 需 org.json:json；一个 jar 两端通用）</description>
    <url>https://github.com/zhkl0228/pac/tree/master/r0rpc-clients/java</url>
    <licenses>
        <license>
            <name>The Apache Software License, Version 2.0</name>
            <url>https://www.apache.org/licenses/LICENSE-2.0.txt</url>
        </license>
    </licenses>
    <developers>
        <developer>
            <name>zhkl0228</name>
            <email>zhkl0228@gmail.com</email>
        </developer>
    </developers>
    <scm>
        <connection>scm:git:git@github.com:zhkl0228/pac.git</connection>
        <developerConnection>scm:git:git@github.com:zhkl0228/pac.git</developerConnection>
        <url>git@github.com:zhkl0228/pac.git</url>
    </scm>

    <!-- 独立工程，不挂在 pac 的 pom 下：它是设备端产物，不参与 WAR 构建 -->

    <properties>
        <project.build.sourceEncoding>UTF-8</project.build.sourceEncoding>
        <maven.test.skip>true</maven.test.skip>
        <!-- d8/r8 的纯 Java 制品版本；换版本只动这里 -->
        <r8.version>8.7.18</r8.version>
    </properties>

    <!-- r8(com.android.tools:r8)只在 Google Maven 上；仅这个 plugin 用得到 -->
    <pluginRepositories>
        <pluginRepository>
            <id>google</id>
            <url>https://maven.google.com</url>
        </pluginRepository>
    </pluginRepositories>

    <dependencies>
        <!-- JSON 数据模型用 org.json。Android(框架/android.jar)自带,所以 provided:
             不打进产物、不传递给使用方;桌面 JVM 使用方需自行加 org.json:json。 -->
        <dependency>
            <groupId>org.json</groupId>
            <artifactId>json</artifactId>
            <version>20231013</version>
            <scope>provided</scope>
        </dependency>
        <!-- WebSocket 客户端。Android / Java 8 都没有内置 WS 客户端,所以必须打包(compile):
             桌面使用方走传递依赖;Android-AGP 打进 APK;frida 的 dex 里也一并 d8 进去(见下面 dex 步骤)。
             Java-WebSocket 是 Java 7 字节码,两端都兼容。 -->
        <dependency>
            <groupId>org.java-websocket</groupId>
            <artifactId>Java-WebSocket</artifactId>
            <version>1.5.7</version>
        </dependency>
        <!-- Java-WebSocket 的日志依赖;显式声明好固定版本(dex 打包按文件名引用)。无 provider 时 NOP。 -->
        <dependency>
            <groupId>org.slf4j</groupId>
            <artifactId>slf4j-api</artifactId>
            <version>1.7.36</version>
        </dependency>
    </dependencies>

    <build>
        <!-- 沿用 SDK 原有的目录结构，不强行改成 src/main/java -->
        <sourceDirectory>${project.basedir}/src</sourceDirectory>
        <plugins>
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-compiler-plugin</artifactId>
                <version>3.13.0</version>
                <configuration>
                    <!-- Android 侧要 Java 8 字节码；JDK 21/25 编译时只会有一条 obsolete 警告 -->
                    <release>8</release>
                </configuration>
            </plugin>
            <plugin>
                <!-- 发 Central 必须带 sources jar -->
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-source-plugin</artifactId>
                <version>3.3.1</version>
                <executions>
                    <execution>
                        <id>attach-sources</id>
                        <goals>
                            <goal>jar</goal>
                        </goals>
                    </execution>
                </executions>
            </plugin>
            <plugin>
                <!-- 发 Central 必须带 javadoc jar；SDK 是 Java8 源码，doclint 关掉免得注释小瑕疵报错 -->
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-javadoc-plugin</artifactId>
                <version>3.11.2</version>
                <configuration>
                    <source>8</source>
                    <additionalOptions>-Xdoclint:none</additionalOptions>
                </configuration>
                <executions>
                    <execution>
                        <id>attach-javadoc</id>
                        <goals>
                            <goal>jar</goal>
                        </goals>
                    </execution>
                </executions>
            </plugin>
            <plugin>
                <!-- 把运行时依赖(Java-WebSocket + slf4j;org.json 是 provided 不含)拷到 dex-libs/，
                     供下面 d8 一起打进 dex(frida 加载的 dex 要自包含) -->
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-dependency-plugin</artifactId>
                <version>3.6.1</version>
                <executions>
                    <execution>
                        <id>copy-dex-libs</id>
                        <phase>prepare-package</phase>
                        <goals><goal>copy-dependencies</goal></goals>
                        <configuration>
                            <includeScope>runtime</includeScope>
                            <outputDirectory>${project.build.directory}/dex-libs</outputDirectory>
                        </configuration>
                    </execution>
                </executions>
            </plugin>
            <plugin>
                <!-- 产出「含 classes.dex 的 dex jar」，随 deploy 作为 dex 分类器发到 Central，
                     供 Android 运行时直接加载(如 Frida：普通 class jar 在设备上加载不了，
                     Android 14+ 的 W^X 只认 App 私有、只读的 dex)。
                     用 Google Maven 的纯 Java d8(com.android.tools:r8 里的 D8 主类)来转，
                     不依赖本地 Android SDK / build-tools，跨平台。
                     注意：这个 goal 在 Maven 自身的 JVM 里跑，d8/r8 需要 JDK 17+，
                     所以构建本模块要用 JDK 17 及以上(编译仍产出 release 8 字节码)。 -->
                <groupId>org.codehaus.mojo</groupId>
                <artifactId>exec-maven-plugin</artifactId>
                <version>3.5.0</version>
                <executions>
                    <execution>
                        <id>dex-android-frida</id>
                        <phase>package</phase>
                        <goals>
                            <goal>java</goal>
                        </goals>
                        <configuration>
                            <mainClass>com.android.tools.r8.D8</mainClass>
                            <!-- 只用插件自带的 r8 依赖，别把工程 classpath 混进来 -->
                            <addOutputToClasspath>false</addOutputToClasspath>
                            <includeProjectDependencies>false</includeProjectDependencies>
                            <includePluginDependencies>true</includePluginDependencies>
                            <arguments>
                                <argument>--release</argument>
                                <!-- 21 起足够；RelayClient 是 Java8 字节码 -->
                                <argument>--min-api</argument>
                                <argument>21</argument>
                                <!-- output 参数给 .jar 路径时，d8 直接产出含 classes.dex 的 jar；
                                     产到 target 下作为 dex classifier 制品，随 deploy 一起发 Central -->
                                <argument>--output</argument>
                                <argument>${project.build.directory}/${project.build.finalName}-dex.jar</argument>
                                <argument>${project.build.directory}/${project.build.finalName}.jar</argument>
                                <argument>${project.build.directory}/dex-libs/Java-WebSocket-1.5.7.jar</argument>
                                <argument>${project.build.directory}/dex-libs/slf4j-api-1.7.36.jar</argument>
                            </arguments>
                        </configuration>
                    </execution>
                </executions>
                <dependencies>
                    <dependency>
                        <groupId>com.android.tools</groupId>
                        <artifactId>r8</artifactId>
                        <version>${r8.version}</version>
                    </dependency>
                </dependencies>
            </plugin>
            <plugin>
                <!-- 把 d8 产出的 dex jar 作为 classifier=dex 的附加制品挂上，
                     这样 deploy 会同时发布：
                       主 jar          → J2SE / 桌面 JVM，以及 Android 用 AGP 自己 dex 的工程
                       xxx-dex.jar     → Android 运行时直接加载 dex 的场景(如 Frida)
                     依赖方按需取 classifier：com.github.zhkl0228:r0rpc-relay-client:1.2.0(:dex) -->
                <groupId>org.codehaus.mojo</groupId>
                <artifactId>build-helper-maven-plugin</artifactId>
                <version>3.6.0</version>
                <executions>
                    <execution>
                        <id>attach-dex</id>
                        <phase>package</phase>
                        <goals>
                            <goal>attach-artifact</goal>
                        </goals>
                        <configuration>
                            <artifacts>
                                <artifact>
                                    <file>${project.build.directory}/${project.build.finalName}-dex.jar</file>
                                    <type>jar</type>
                                    <classifier>dex</classifier>
                                </artifact>
                            </artifacts>
                        </configuration>
                    </execution>
                </executions>
            </plugin>
            <plugin>
                <!-- 发 Central 要 GPG 签名；用本机密钥(Banny nexus)，verify 阶段签 -->
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-gpg-plugin</artifactId>
                <version>3.1.0</version>
                <executions>
                    <execution>
                        <id>sign-artifacts</id>
                        <phase>verify</phase>
                        <goals>
                            <goal>sign</goal>
                        </goals>
                    </execution>
                </executions>
            </plugin>
            <plugin>
                <!-- 直发 Sonatype Central；publishingServerId=oss 对应 settings.xml 里的 oss 令牌 -->
                <groupId>org.sonatype.central</groupId>
                <artifactId>central-publishing-maven-plugin</artifactId>
                <version>0.10.0</version>
                <extensions>true</extensions>
                <configuration>
                    <publishingServerId>oss</publishingServerId>
                    <autoPublish>true</autoPublish>
                    <waitUntil>published</waitUntil>
                </configuration>
            </plugin>
        </plugins>
    </build>

</project>
